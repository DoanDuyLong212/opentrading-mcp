# Copy to .env and fill. Never commit .env.
# Local team stack (docker-compose.mcp.yml remapped ports to avoid clashes)
DATABASE_URL=postgresql://trading:trading@localhost:15432/mcp
REDIS_URL=redis://localhost:16379/0
MCP_PORT=8102
MCP_PRESET=market

# Team shared bearer (rotate monthly). Empty = local stdio without auth.
MCP_BEARER_TEAM=replace-me

# Upstream credentials (server-side only, never sent to MCP clients)
VIETSTOCK_EMAIL=
VIETSTOCK_PASSWORD=
# VIETSTOCK_COOKIE_LOGIN=  # JWT, refresh via cron <7d (current exp 2026-10-02)
DNSE_API_KEY=
DNSE_SECRET=
FIREANT_TOKEN=
GROQ_API_KEY=
FRED_API_KEY=
# Web search providers (paid; free tiers exist). Missing both = web_search hidden.
EXA_API_KEY=
PARALLEL_API_KEY=
# Force provider: exa | parallel | unset = auto A/B by query hash
# WEBSEARCH_PROVIDER=
