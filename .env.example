# Copy to .env and fill. Never commit .env.
# Local team stack (docker-compose.mcp.yml remapped ports to avoid clashes)
DATABASE_URL=postgresql://trading:trading@localhost:15432/mcp
# Cache tier (optional): unset = process-memory fallback (lost on restart).
# Local docker: redis://localhost:16379/0
# Upstash (same account as Trading_Agents): derive the native endpoint from the
# REST host — rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<host>:6379
# (redis-py speaks RESP, not the REST API; never log or commit the URL).
REDIS_URL=redis://localhost:16379/0
MCP_PORT=8102
MCP_PRESET=market
# Blocking upstream slots (default 2): raise to 4 on 1+ CPU hosts; tool fan-out
# semaphores follow this value automatically.
# MCP_BLOCKING_SLOTS=2

# Team shared bearer (rotate monthly). Empty = local stdio without auth.
MCP_BEARER_TEAM=replace-me

# Upstream credentials (server-side only, never sent to MCP clients)
VIETSTOCK_EMAIL=
VIETSTOCK_PASSWORD=
# VIETSTOCK_COOKIE_LOGIN=  # JWT, refresh via cron <7d (current exp 2026-10-02)
# TRADING_AGENTS_DIR=      # repo holding backend/mcp/tools/vietstock/session.json (default ~/Trading_Agents)
DNSE_API_KEY=
DNSE_SECRET=
FIREANT_TOKEN=
GROQ_API_KEY=
FRED_API_KEY=
# Web search providers (paid; free tiers exist). Missing both = web_search hidden.
EXA_API_KEY=
PARALLEL_API_KEY=
# Force provider: exa | parallel | unset = auto A/B by query hash
# WEBSEARCH_PROVIDER=
